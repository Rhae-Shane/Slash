# Local Docker Postgres (optional)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public"

# Supabase (transaction pooler + direct URL for migrations)
DATABASE_URL="postgresql://postgres.gxjmqqykjgwwerifixls:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.gxjmqqykjgwwerifixls.supabase.co:5432/postgres"

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL="https://able-chigger-292607.upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-TOKEN]"

# Required for POST /api/v1/urls and DELETE /api/v1/urls/:shortCode
API_KEY="change-me-to-a-long-secret"

NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
LOG_LEVEL=info

# Rate limits (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_CREATE_MAX=20
